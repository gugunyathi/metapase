# --- Frontend (safe to expose: these are bundled into the browser) ---
VITE_METAPASE_API_BASE=http://localhost:3000
VITE_METAPASE_DATA_SOURCE=live

# --- Server only: NEVER prefix these with VITE_ and never commit a real .env ---
# MongoDB (optional: without it the server uses an in-memory store)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxxx.mongodb.net/<dbname>

# Muse Spark (Meta developer console). Without a key the app runs on its rules-based agents.
MODEL_API_KEY=
MUSE_API_BASE=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
# MUSE_TIMEOUT_MS=6000

# To run on Muse Spark Open (open weights) instead, point these at your Baseten endpoint:
# MUSE_API_BASE=<OpenAI-compatible base URL from Baseten>
# MODEL_API_KEY=<Baseten key>
# MUSE_MODEL=meta-models/muse-spark-open-1026

# Origins allowed to call the Node server from a browser (add your deployed frontend URL)
# METAPASE_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
