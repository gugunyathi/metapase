# ==============================================================================
# AutoCom - Environment Variables & Secrets Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. PayPal Sandbox & Braintree Vault (Hackathon Track)
# ------------------------------------------------------------------------------
# Client-side PayPal Sandbox Client ID (used by frontend SDK in src/services/paypalService.ts)
VITE_PAYPAL_SANDBOX_CLIENT_ID="sb-autocom-agent-sandbox-client-id-2026"

# Server-side PayPal REST API credentials for order verification & capture
PAYPAL_CLIENT_ID="sb-autocom-agent-sandbox-client-id-2026"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_secret_here"
PAYPAL_MODE="sandbox"
PAYPAL_MERCHANT_RECEIVER="merchant-belair-clearinghouse@autocom.dev"

# ------------------------------------------------------------------------------
# 2. MongoDB Database Configuration (Multi-Mall & Transaction Ledger)
# ------------------------------------------------------------------------------
# Connection URI for MongoDB Atlas or local MongoDB instance (used in src/services/mongodb.ts)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/autocom_db?retryWrites=true&w=majority
MONGODB_URI=""
MONGODB_DB_NAME="autocom_db"

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Engine
# ------------------------------------------------------------------------------
# Server-side Gemini API key for autonomous bilateral agent negotiation & LLM reasoning
GEMINI_API_KEY="your_google_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 4. Webhook Security & Automated Cross-Rail Recovery
# ------------------------------------------------------------------------------
# Secret signature verification token for /webhooks/payments endpoint
WEBHOOK_SECRET="autocom_webhook_secret_key_2026"

# ------------------------------------------------------------------------------
# 5. Channel3 WebRTC / Canvas Telemetry Broadcast (Hackathon Track)
# ------------------------------------------------------------------------------
# API key for Channel3 live spatial radar & LLM negotiation stream pipeline
CHANNEL3_API_KEY="your_channel3_api_key_here"

# ------------------------------------------------------------------------------
# 6. APIMatic OpenAPI 3.0 SDK Generation (Hackathon Track)
# ------------------------------------------------------------------------------
# APIMatic portal API key for automated multi-language SDK compilation
APIMATIC_API_KEY="your_apimatic_api_key_here"

# ------------------------------------------------------------------------------
# 7. Multi-Chain RPCs & Sovereign Settlement (.agent Registry & x402)
# ------------------------------------------------------------------------------
BASE_RPC_URL="https://mainnet.base.org"
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
AGENT_TREASURY_WALLET="0x49B0E1F8C2224424B10a82B93E94d1F3238385a4"

# ------------------------------------------------------------------------------
# 8. Server & Host Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
VITE_BASE_URL="http://localhost:3000"
