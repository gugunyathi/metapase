# =============================================================================
# METAPASE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy the variables below into your local .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONTEND / VITE (Safe to expose: bundled into client browser)
# -----------------------------------------------------------------------------
VITE_METAPASE_API_BASE=http://localhost:3000
VITE_METAPASE_DATA_SOURCE=live
VITE_METAPASE_MUSE_BASE=http://localhost:3000

# PayPal Sandbox Client ID for frontend agent checkout & M2M simulation
VITE_PAYPAL_SANDBOX_CLIENT_ID=AVZv60PIBfNkjYbTKqePHwRCXxMGCLKNn4XceXJKyJtO6ltnaDyWypF8Gi3jqGrWxf5irXnJK1SSdAg6

# -----------------------------------------------------------------------------
# 2. SERVER & DATABASE (Keep private: never commit real credentials)
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# MongoDB Atlas URI (falls back to in-memory store if unset)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxxx.mongodb.net/metapase?retryWrites=true&w=majority

# Meta Muse Spark API (developer console key for store bargaining agents)
MODEL_API_KEY=
MUSE_API_BASE=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_TIMEOUT_MS=6000

# -----------------------------------------------------------------------------
# 3. PAYPAL SANDBOX & AGENT M2M VAULT SETTINGS
# -----------------------------------------------------------------------------
PAYPAL_SANDBOX_CLIENT_ID=AVZv60PIBfNkjYbTKqePHwRCXxMGCLKNn4XceXJKyJtO6ltnaDyWypF8Gi3jqGrWxf5irXnJK1SSdAg6
PAYPAL_SANDBOX_CLIENT_SECRET=<your-paypal-sandbox-client-secret>
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CURRENCY_TARGET=USD
PAYPAL_CURRENCY_SOURCE=ZAR
PAYPAL_MERCHANT_RECEIVER=merchant-belair-clearinghouse@autocom.dev
PAYPAL_VAULT_PREFIX=VAULT_AUTONOMOUS_DELEGATE_

# -----------------------------------------------------------------------------
# 4. SECURITY, WEBAUTHN PASSKEYS & CORS ORIGINS
# -----------------------------------------------------------------------------
# WebAuthn relying party domain (e.g. localhost or your-app.vercel.app)
METAPASE_RP_ID=localhost

# Proximity beacon matching radius in meters
METAPASE_MATCH_RADIUS_M=50

# Allow biometric sandbox passkey authentication
METAPASE_ALLOW_SANDBOX_PAY=true

# Comma-separated list of allowed frontend origins (CORS)
METAPASE_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,https://your-app.vercel.app
