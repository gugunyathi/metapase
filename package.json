{
  "name": "metapase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "tsx server/server.ts",
    "db:seed": "tsx scripts/seed-db.ts",
    "agent:shopping": "tsx agent/personalShoppingAgent.ts",
    "dev:all": "concurrently --kill-others-on-fail -n SERVER,FRONTEND -c cyan,magenta \"tsx server/server.ts\" \"vite\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test server/muse.test.ts",
    "muse:check": "tsx scripts/muse-check.ts"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^8.7.0",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.0"
  }
}
