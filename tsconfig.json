{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/components/**/*",
    "src/hooks/**/*",
    "src/lib/**/*",
    "src/pages/**/*",
    "src/types/**/*",
    "src/config/**/*",
    "vite.config.ts"
  ],
  "exclude": [
    "src/routes/**/*",
    "src/services/**/*",
    "src/test/**/*",
    "src/client.tsx",
    "src/start.ts",
    "src/server.ts",
    "src/router.tsx",
    "src/components/ui/**/*",
    "src/components/AutoComApp.tsx",
    "src/components/adserver/**/*",
    "src/components/bitchat/**/*",
    "src/components/developer/**/*",
    "src/components/home/**/*",
    "src/components/marketplace/**/*",
    "src/components/merchant/**/*",
    "src/components/names/**/*",
    "src/components/paypal/**/*",
    "src/components/agent/CreateAgentModal.tsx",
    "src/components/agent/FloatingCreateAgentButton.tsx",
    "src/components/A2ATransactionAuditLedger.tsx",
    "src/components/AgentCommerceModal.tsx",
    "src/components/AgentLiveStream.tsx",
    "src/components/BoughtItemsModal.tsx",
    "src/components/CornerCompass.tsx",
    "src/components/DatabaseStatusModal.tsx",
    "src/components/DealMatchPopup.tsx",
    "src/components/EnvironmentModal.tsx",
    "src/components/FloatingDeckCard.tsx",
    "src/components/InteractiveDealCard.tsx",
    "src/components/LandingPage.tsx",
    "src/components/MallSimulator.tsx",
    "src/components/MatchedDeckModal.tsx",
    "src/components/ParkingLotModal.tsx",
    "src/components/PasskeyModal.tsx",
    "src/components/PayPalHackathonModal.tsx",
    "src/components/PitchDeckModal.tsx",
    "src/components/PWAInstallButton.tsx",
    "src/components/SpatialCompassHUD.tsx",
    "src/components/StoreProductsModal.tsx",
    "src/hooks/useAutoComPayments.ts",
    "src/hooks/useBitchat.ts",
    "src/hooks/useConversationalVoiceAgent.ts",
    "src/hooks/useDeviceHeading.ts",
    "src/hooks/useWeb3Wallet.ts",
    "src/lib/agent-commerce.ts",
    "src/lib/acn-data.ts",
    "src/lib/malls.ts",
    "src/lib/mall-types.ts",
    "src/lib/malls/**/*",
    "src/lib/notifications.ts",
    "src/lib/offers-cache.ts",
    "src/lib/passkey-auth.ts",
    "src/lib/pitch-deck-pdf.ts",
    "src/lib/pwa-service.ts",
    "src/lib/spatial-sensors.ts",
    "src/lib/utils.ts",
    "src/types/autocom.ts",
    "src/types/adserver.ts",
    "src/types/bitchat.ts",
    "src/types/userAgent.ts"
  ]
}
